{
  "name": "dsh-plugin-opencode2api",
  "version": "1.2.0",
  "description": "Unofficial one-click installer and auto-runner for opencode2api — a local free OpenAI-compatible API gateway — inside DSH, with a desktop settings UI and a dsh-go native panel (Windows, macOS, Linux, Android).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/king-andthe-nice/dsh-plugin-opencode2api.git"
  },
  "homepage": "https://github.com/king-andthe-nice/dsh-plugin-opencode2api#readme",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-go",
    "opencode",
    "opencode2api",
    "gateway",
    "openai-compatible",
    "free-api"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "本地免费 API",
      "en": "Local Free API"
    },
    "icon": "server",
    "contributes": {
      "composer.actions": [
        {
          "id": "open-gateway",
          "label": {
            "zh": "本地API",
            "en": "Local API"
          },
          "icon": "server",
          "effect": [
            {
              "type": "open",
              "page": "panel:gateway"
            }
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "status",
          "icon": "server",
          "panel": "gateway"
        }
      ],
      "panels": [
        {
          "id": "gateway",
          "title": {
            "zh": "本地免费 API",
            "en": "Local Free API"
          },
          "icon": "server",
          "placement": [
            "session.tab",
            "features",
            "plugin"
          ]
        }
      ]
    }
  }
}
